# ─── Odyssey Panel (Cloudflare edition) ───────────────────────────
# Local development only. On Cloudflare Workers the database is D1
# (bound as `DB` in wrangler.jsonc) — no DATABASE_URL is needed there.

# Local SQLite file used by `next dev` without wrangler bindings.
DATABASE_URL=file:./db/local.db

# Optional: pin the public URL used in subscription links / QR codes.
# Leave empty to auto-detect from the browser you manage the panel with.
PANEL_PUBLIC_URL=
