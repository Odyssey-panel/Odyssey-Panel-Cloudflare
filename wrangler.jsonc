// Odyssey Panel — Cloudflare Workers configuration
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
//
// One-time setup (see DEPLOY-CF.md):
//   npx wrangler d1 create odyssey-db
//   → copy the printed database_id into the binding below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odyssey-panel",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "odyssey-db",
      // Fresh D1 on the new account (migrated from the old one, 2026-11-18).
      "database_id": "a65fa2c8-360b-4930-a339-5577633a201c",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "2dc064b1878843fca53926fa6183c0f0" },
    { "binding": "NEXT_INC_CACHE_KV", "id": "56fd2bb0a7ae4f9e8e70741b03930a1f" }
  ],
  // SPEED: Smart Placement — Cloudflare runs the worker close to its data
  // (D1), so each request pays the long hop once instead of paying it for
  // every sequential D1 query.
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true
  }
}
