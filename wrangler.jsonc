// Odyssey Panel — Cloudflare Workers configuration
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
//
// One-time setup (see DEPLOY-CF.md):
//   npx wrangler d1 create odyssey-db
//   → copy the printed database_id into the binding below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odyssey-panel",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "odyssey-db",
      // Fresh D1 on the current account (recreated after the old account was banned).
      "database_id": "071049ed-d446-4a73-82d6-bdbbb4501d35",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "1444b6375d9844248d3481fffc8bed46" },
    { "binding": "NEXT_INC_CACHE_KV", "id": "25ad2c4c7e1e4e96b03414e4e66d60b7" }
  ],
  // SPEED: Smart Placement — Cloudflare runs the worker close to its data
  // (D1), so each request pays the long hop once instead of paying it for
  // every sequential D1 query.
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true
  }
}
