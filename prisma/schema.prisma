generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A subscriber of the proxy/subscription service
model Client {
  id        String   @id @default(cuid())
  name      String   @unique
  note      String?
  // 0 = unlimited
  limitBytes BigInt   @default(0)
  usedBytes  BigInt   @default(0)
  // null = never expires
  expiresAt DateTime?
  // "start from first connection": expiry anchored to startedAt when set
  startedAt DateTime?
  // Zeus-style "start on first connection": anchor expiry at the first
  // subscription fetch instead of the creation moment
  startOnFirstConnection Boolean @default(false)
  // fastest-mode client: clean-IP-first configs, fastest-first sub ordering,
  // dead-protocol auto-replace driven by the sub page device test
  fastMode Boolean @default(false)
  // days granted at creation — used to re-anchor expiresAt on first connection
  planDays Int @default(0)
  // request quota (0 = unlimited)
  usedRequests Int    @default(0)
  requestLimit Int    @default(0)
  // concurrent device (unique IP) cap, 0 = unlimited
  ipLimit      Int    @default(0)
  // automatic quota reset cycles in days, 0 = never
  resetBytesDays    Int      @default(0)
  resetRequestsDays Int      @default(0)
  lastBytesResetAt    DateTime?
  lastRequestsResetAt DateTime?
  // allow the "direct" (no-proxy) config for this user
  directEnabled Boolean @default(true)
  // TLS ClientHello fingerprint carried into generated links
  fingerprint String @default("chrome")
  // operator/ISP tag (Mokhaberat, Irancell, ...)
  isp String?
  status    String   @default("active") // active | disabled
  subToken  String   @unique
  proxies   Proxy[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A locally generated proxy/VPN account belonging to a client
model Proxy {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  protocol     String // vless | vmess | trojan | shadowsocks
  remark       String
  address      String
  port         Int
  secret       String // uuid (vless/vmess) or password (trojan/ss)
  sni          String?
  host         String?
  path         String?
  transport    String   @default("ws") // ws | grpc | tcp
  tls          Boolean  @default(true)
  flow         String?
  fragment     String? // TLS-fragment "<length>,<interval>,<packets>" (anti-censorship)
  fp           String? // TLS ClientHello fingerprint override (chrome, ios, ...)
  ech          String? // Encrypted ClientHello config (public name / resolver)
  plugin       String? // e.g. v2ray-plugin websocket parameters for shadowsocks
  // VLESS-Reality client params (JSON: {pbk, sid, spx}) — VPS backend, no
  // domain/cert needed. The server private key lives in Setting.realityKeys.
  reality      String?
  serverConfig String? // JSON server-side inbound config for xray/sing-box
  createdAt    DateTime @default(now())
}

// Backend node (VPS/inbound) tracked with simple TCP/TLS health checks
model Node {
  id            String    @id @default(cuid())
  name          String
  address       String
  port          Int
  protocol      String    @default("vless")
  tls           Boolean   @default(true)
  sni           String?
  location      String?
  status        String    @default("unknown") // up | down | unknown
  latencyMs     Int?
  certExpiresAt DateTime?
  lastCheckedAt DateTime?
  note          String?
  createdAt     DateTime  @default(now())
}

// Cloudflare worker / external endpoint tracked with HTTP health checks
model Worker {
  id            String    @id @default(cuid())
  name          String
  url           String
  status        String    @default("unknown") // up | down | unknown
  latencyMs     Int?
  httpStatus    Int?
  lastCheckedAt DateTime?
  note          String?
  createdAt     DateTime  @default(now())
}

// Key/value panel settings (admin password hash, panel URL, ...)
model Setting {
  key   String @id
  value String
}
